{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "autoprefixer": "^10.5.4",
    "axios": "^1.19.0",
    "craco": "^0.0.3",
    "lucide-react": "^1.28.0",
    "postcss": "^8.5.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "react-router-dom": "^6.30.4",
    "react-scripts": "5.0.1",
    "tailwindcss": "^4.3.3",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "run-p tailwind:watch react:start",
    "react:start": "react-scripts start",
    "tailwind:watch": "tailwindcss -i ./src/index.css -o ./src/output.css --watch",
    "build": "tailwindcss -i ./src/index.css -o ./src/output.css && react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "allowScripts": {
    "core-js@3.49.0": true,
    "core-js-pure@3.49.0": true
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "npm-run-all": "^4.1.5"
  }
}
